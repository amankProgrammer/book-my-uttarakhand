rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // TODO: Replace with your real admin email(s).
    // Keep this list short; it's only for the first-time bootstrap.
    function bootstrapAdminEmails() {
      return ["admin@gmail.com"];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && (request.auth.token.email in bootstrapAdminEmails());
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      // Bootstrap: allow whitelisted email to create their own admin doc once.
      allow create: if isBootstrapAdmin() && uid == request.auth.uid;
      // Keep admin management manual (console) for safety.
      allow update, delete: if isBootstrapAdmin();
    }

    match /heroSlides/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homeDestinations/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homePackages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /destinations/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hotels/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /about/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contact/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /newsletterSignups/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

